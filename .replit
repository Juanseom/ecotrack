run = "streamlit run app.py --server.port 8080 --server.address 0.0.0.0"
entrypoint = "app.py"
modules = ["python-3.11"]

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "autoscale"
run = ["sh", "-c", "streamlit run app.py --server.port 8080 --server.address 0.0.0.0"]

[[ports]]
localPort = 8080
externalPort = 80
